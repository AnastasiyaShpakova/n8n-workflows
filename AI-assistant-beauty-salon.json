{
  "name": "ИИ ассистент для салона в Телеграмм",
  "nodes": [
    {
      "parameters": {
        "method": "POST",
        "url": "https://gigachat.devices.sberbank.ru/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"GigaChat-2\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Ты — помощник салона красоты. Отвечай на вопросы клиентов, используя только предоставленный контекст. Если в контексте нет информации — честно скажи: 'Извините, я не знаю ответа на этот вопрос'. Не выдумывай факты.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Контекст: {{ $('Достать текст').item.json.context }}\\n\\nВопрос: {{ $('Подготовка вопроса').item.json.question }}\"\n    }\n  ],\n  \"temperature\": 0.5,\n  \"max_tokens\": 500\n}",
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2080,
        32
      ],
      "id": "40febb0c-8b34-496d-93d3-24d1c87a1005",
      "name": "Ответ от GigaChat"
    },
    {
      "parameters": {
        "jsCode": "// Получаем вопрос из Telegram\nconst question = $input.first().json.message.text;\n\nreturn {\n  json: {\n    question: question\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        544,
        32
      ],
      "id": "a163fe6c-21b2-4f51-8f97-fb4cc2197526",
      "name": "Подготовка вопроса"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://YOUR_SERVER_IP:11434/api/embed",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"nomic-embed-text\",\n  \"input\": \"{{ $json.question }}\"\n}",
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        784,
        32
      ],
      "id": "03f0cd0d-ab2b-40f3-9e46-58acdcd4d7d3",
      "name": "Ollama embeddings"
    },
    {
      "parameters": {
        "jsCode": "// Получаем вектор вопроса из ответа Ollama\nconst embedding = $input.first().json.embeddings[0];\n\nreturn {\n  json: {\n    vector: embedding,\n    limit: 3,           // сколько чанков вернуть (топ-3 самых похожих)\n    with_payload: true  // вернуть текст чанков вместе с векторами\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        32
      ],
      "id": "721398ef-b4cc-45af-8b7a-4784d5c2d2a1",
      "name": "Собрать запрос (float)"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://YOUR_SERVER_IP:6333/collections/beauty_salon_collection/points/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"vector\": {{ JSON.stringify($json.vector) }},\n  \"limit\": {{ $json.limit }},\n  \"with_payload\": {{ $json.with_payload }}\n}",
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1248,
        32
      ],
      "id": "5426eb88-be95-48dc-9f7d-9c5fda7c3b0f",
      "name": "Qdrant search"
    },
    {
      "parameters": {
        "jsCode": "// Получаем результат поиска из Qdrant\nconst result = $input.first().json.result;\n\n// Извлекаем текст из payload каждого найденного чанка\nconst texts = result.map(item => item.payload.text).filter(t => t);\n\n// Объединяем тексты в один контекст\n// Заменяем переносы строк и кавычки на безопасные символы\nlet context = texts.join('\\n\\n---\\n\\n');\ncontext = context.replace(/\\n/g, ' ').replace(/\\r/g, '').replace(/\"/g, \"'\");\n\nreturn {\n  json: {\n    context: context\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1456,
        32
      ],
